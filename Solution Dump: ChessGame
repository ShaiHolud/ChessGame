namespace ChessGame.Server.Controllers
{
    [ApiController]
    [Route("api/games")]
    public sealed class GamesController : ControllerBase
    {
        private readonly IChessGameService _gameService;

        public GamesController(
            IChessGameService gameService)
        {
            _gameService = gameService;
        }

        // ============================================================
        // CREATE
        // ============================================================

        [HttpPost]
        [SwaggerOperation(
            Summary = "Создает партию",
            Description =
                "Создает новую шахматную партию.",
            OperationId = "CreateGame",
            Tags = new[] { "Games" })]
        [SwaggerResponse(
            200,
            "Шахматная партия успешно создана")]
        public ActionResult<GameDto> Create()
        {
            GameDto game =
                _gameService.CreateGame();

            return Ok(game);
        }

        // ============================================================
        // GET
        // ============================================================

        [HttpGet("{id:guid}")]
        [SwaggerOperation(
            Summary = "Получает партию",
            Description =
                "Возвращает текущее состояние шахматной партии.",
            OperationId = "GetGame",
            Tags = new[] { "Games" })]
        [SwaggerResponse(
            200,
            "Данные шахматной партии успешно получены")]
        [SwaggerResponse(
            404,
            "Шахматная партия не найдена")]
        public ActionResult<GameDto> Get(Guid id)
        {
            try
            {
                GameDto game =
                    _gameService.GetGame(id);

                return Ok(game);
            }
            catch (KeyNotFoundException)
            {
                return NotFound();
            }
        }

        // ============================================================
        // MOVE
        // ============================================================

        [HttpPost("{id:guid}/move")]
        [SwaggerOperation(
            Summary = "Делает ход",
            Description =
                "Выполняет ход в указанной шахматной партии.",
            OperationId = "MakeMove",
            Tags = new[] { "Games" })]
        [SwaggerResponse(
            200,
            "Ход успешно выполнен")]
        [SwaggerResponse(
            400,
            "Недопустимый ход")]
        [SwaggerResponse(
            404,
            "Шахматная партия не найдена")]
        public ActionResult<MoveResultDto> Move(
            Guid id,
            [FromBody] MoveDto move)
        {
            try
            {
                MoveResultDto result =
                    _gameService.MakeMove(
                        id,
                        move);

                return Ok(result);
            }
            catch (KeyNotFoundException)
            {
                return NotFound();
            }
            catch (InvalidOperationException ex)
            {
                return BadRequest(
                    new
                    {
                        Error = ex.Message
                    });
            }
            catch (ArgumentException ex)
            {
                return BadRequest(
                    new
                    {
                        Error = ex.Message
                    });
            }
        }

        // ============================================================
        // UNDO
        // ============================================================

        [HttpPost("{id:guid}/undo")]
        [SwaggerOperation(
            Summary = "Отменяет последний ход",
            Description =
                "Возвращает партию в состояние до последнего хода.",
            OperationId = "UndoMove",
            Tags = new[] { "Games" })]
        [SwaggerResponse(
            200,
            "Ход успешно отменен")]
        [SwaggerResponse(
            404,
            "Шахматная партия не найдена")]
        public ActionResult<GameDto> Undo(Guid id)
        {
            try
            {
                GameDto game =
                    _gameService.UndoMove(id);

                return Ok(game);
            }
            catch (KeyNotFoundException)
            {
                return NotFound();
            }
        }

        // ============================================================
        // LEGAL MOVES
        // ============================================================

        [HttpGet("{id:guid}/legalmoves/{square}")]
        [SwaggerOperation(
            Summary = "Получает допустимые ходы",
            Description =
                "Возвращает все допустимые клетки для фигуры на указанной позиции.",
            OperationId = "GetLegalMoves",
            Tags = new[] { "Games" })]
        [SwaggerResponse(
            200,
            "Список допустимых ходов успешно получен")]
        [SwaggerResponse(
            400,
            "Некорректная шахматная позиция")]
        [SwaggerResponse(
            404,
            "Шахматная партия не найдена")]
        public ActionResult<
            IReadOnlyCollection<PositionDto>>
            LegalMoves(
                Guid id,
                string square)
        {
            try
            {
                PositionDto position =
                    ParsePosition(square);

                IReadOnlyCollection<PositionDto> moves =
                    _gameService.GetLegalMoves(
                        id,
                        position);

                return Ok(moves);
            }
            catch (KeyNotFoundException)
            {
                return NotFound();
            }
            catch (ArgumentException ex)
            {
                return BadRequest(
                    new
                    {
                        Error = ex.Message
                    });
            }
        }

        // ============================================================
        // DELETE
        // ============================================================

        [HttpDelete("{id:guid}")]
        [SwaggerOperation(
            Summary = "Удаляет партию",
            Description =
                "Удаляет шахматную партию.",
            OperationId = "DeleteGame",
            Tags = new[] { "Games" })]
        [SwaggerResponse(
            204,
            "Шахматная партия удалена")]
        [SwaggerResponse(
            404,
            "Шахматная партия не найдена")]
        public IActionResult Delete(Guid id)
        {
            bool removed =
                _gameService.DeleteGame(id);

            if (!removed)
            {
                return NotFound();
            }

            return NoContent();
        }

        // ============================================================
        // GET ALL
        // ============================================================

        [HttpGet]
        [SwaggerOperation(
            Summary = "Получает список партий",
            Description =
                "Возвращает список всех активных партий.",
            OperationId = "GetGames",
            Tags = new[] { "Games" })]
        [SwaggerResponse(
            200,
            "Список партий успешно получен")]
        public ActionResult<
            IReadOnlyCollection<GameInfoDto>>
            GetAll()
        {
            IReadOnlyCollection<GameInfoDto> games =
                _gameService.GetGames();

            return Ok(games);
        }

        // ============================================================
        // POSITION PARSER
        // ============================================================

        private static PositionDto ParsePosition(
            string square)
        {
            if (string.IsNullOrWhiteSpace(square))
            {
                throw new ArgumentException(
                    "Square is required.");
            }

            square =
                square.Trim()
                      .ToLowerInvariant();

            if (square.Length != 2)
            {
                throw new ArgumentException(
                    $"Invalid square '{square}'.");
            }

            char file =
                square[0];

            char rank =
                square[1];

            if (file < 'a' || file > 'h')
            {
                throw new ArgumentException(
                    $"Invalid file in square '{square}'.");
            }

            if (rank < '1' || rank > '8')
            {
                throw new ArgumentException(
                    $"Invalid rank in square '{square}'.");
            }

            return new PositionDto(
                rank - '1',
                file - 'a');
        }
    }
}
