```razor
@using ChessGame.Contracts.Dto
@using ChessGame.ApiClient.Services

@inject IChessGameApiClient ChessGameApiClient

<div class="chess-board">

    @for (int displayRow = 7; displayRow >= 0; displayRow--)
    {
        int row = displayRow;

        @for (int column = 0; column < 8; column++)
        {
            int currentColumn = column;

            PositionDto position = new(
            row,
            currentColumn);

            PieceDto? piece =
            GetPiece(position);

            bool isLightSquare =
            (row + currentColumn) % 2 == 0;

            bool isSelected =
            _selectedPosition is not null &&
            _selectedPosition.Row == position.Row &&
            _selectedPosition.Column == position.Column;

            bool isLegalMove =
            _legalMoves.Any(
            p =>
            p.Row == position.Row &&
            p.Column == position.Column);

            bool isCapture =
            isLegalMove &&
            piece is not null &&
            piece.Color != Game?.CurrentTurn;

            string squareClass =
            GetSquareClass(
            isLightSquare,
            isSelected,
            isLegalMove,
            isCapture);

            <button class="@squareClass"
                    @onclick="() => OnSquareClick(position)">

                @if (piece is not null)
                {
                    <span class="chess-piece">
                        @GetPieceSymbol(piece)
                    </span>
                }

                @if (isLegalMove && piece is null)
                {
                    <span class="move-marker"></span>
                }

                @if (isCapture)
                {
                    <span class="capture-marker"></span>
                }

            </button>
        }
    }

    @if (_pendingPromotionMove is not null)
    {
        <div class="promotion-overlay">

            <div class="promotion-dialog">

                <h3>Choose promotion piece</h3>

                <div class="promotion-pieces">

                    <button @onclick='() => PromoteAsync("Q")'>
                        @GetPromotionSymbol("Q")
                    </button>

                    <button @onclick='() => PromoteAsync("R")'>
                        @GetPromotionSymbol("R")
                    </button>

                    <button @onclick='() => PromoteAsync("B")'>
                        @GetPromotionSymbol("B")
                    </button>

                    <button @onclick='() => PromoteAsync("N")'>
                        @GetPromotionSymbol("N")
                    </button>

                </div>

            </div>

        </div>
    }

</div>

@code
{
    [Parameter]
    public GameDto? Game { get; set; }

    [Parameter]
    public EventCallback<MoveResultDto> OnMoveCompleted { get; set; }

    private PositionDto? _selectedPosition;

    private MoveDto? _pendingPromotionMove;

    private IReadOnlyCollection<PositionDto> _legalMoves =
        Array.Empty<PositionDto>();


    // ============================================================
    // ОБНОВЛЕНИЕ СОСТОЯНИЯ КОМПОНЕНТА
    // ============================================================

    protected override void OnParametersSet()
    {
        ClearSelection();
    }


    // ============================================================
    // Получение фигуры
    // ============================================================

    private PieceDto? GetPiece(
        PositionDto position)
    {
        return Game?
            .Pieces
            .FirstOrDefault(
                p =>
                    p.Position.Row == position.Row &&
                    p.Position.Column == position.Column);
    }


    // ============================================================
    // Клик по клетке
    // ============================================================

    private async Task OnSquareClick(
        PositionDto position)
    {
        Console.WriteLine(
            $"OnSquareClick: {ToSquare(position)}");

        GameDto? game =
            Game;

        if (game is null)
            return;

        PieceDto? piece =
            GetPiece(position);


        // --------------------------------------------------------
        // Ничего не выбрано
        // --------------------------------------------------------

        if (_selectedPosition is null)
        {
            await SelectPiece(
                position,
                piece);

            return;
        }


        // --------------------------------------------------------
        // Проверяем допустимость хода
        // --------------------------------------------------------

        bool isLegalMove =
            _legalMoves.Any(
                p =>
                    p.Row == position.Row &&
                    p.Column == position.Column);

        if (isLegalMove)
        {
            PieceDto? selectedPiece =
                GetPiece(_selectedPosition);

            if (selectedPiece is null)
            {
                ClearSelection();

                await InvokeAsync(
                    StateHasChanged);

                return;
            }

            MoveDto move =
                new(
                    _selectedPosition,
                    position,
                    null);


            // ----------------------------------------------------
            // Превращение пешки
            // ----------------------------------------------------

            if (RequiresPromotion(
                    selectedPiece,
                    position))
            {
                _pendingPromotionMove =
                    move;

                _selectedPosition = null;

                _legalMoves =
                    Array.Empty<PositionDto>();

                await InvokeAsync(
                    StateHasChanged);

                return;
            }


            await ExecuteMoveAsync(
                move);

            return;
        }


        // --------------------------------------------------------
        // Кликнули по своей фигуре
        // --------------------------------------------------------

        if (piece is not null &&
            piece.Color == game.CurrentTurn)
        {
            await SelectPiece(
                position,
                piece);

            return;
        }


        // --------------------------------------------------------
        // Всё остальное
        // --------------------------------------------------------

        ClearSelection();

        await InvokeAsync(
            StateHasChanged);
    }


    // ============================================================
    // Выбор фигуры
    // ============================================================

    private async Task SelectPiece(
        PositionDto position,
        PieceDto? piece)
    {
        Console.WriteLine(
            $"SelectPiece: {ToSquare(position)}, " +
            $"piece: {piece?.Type}, " +
            $"color: {piece?.Color}, " +
            $"current turn: {Game?.CurrentTurn}");

        GameDto? game =
            Game;

        if (game is null)
            return;

        if (piece is null)
            return;

        if (piece.Color != game.CurrentTurn)
            return;

        try
        {
            IReadOnlyCollection<PositionDto> legalMoves =
                await ChessGameApiClient.GetLegalMovesAsync(
                    position);

            _selectedPosition =
                position;

            _legalMoves =
                legalMoves;

            Console.WriteLine(
                $"Selected {ToSquare(position)}. " +
                $"Legal moves: {_legalMoves.Count}");

            foreach (PositionDto move in _legalMoves)
            {
                Console.WriteLine(
                    $"  -> {ToSquare(move)}");
            }

            await InvokeAsync(
                StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Get legal moves failed for " +
                $"{ToSquare(position)}:");

            Console.WriteLine(ex);

            ClearSelection();

            await InvokeAsync(
                StateHasChanged);
        }
    }


    // ============================================================
    // Выполнение хода
    // ============================================================

    private async Task ExecuteMoveAsync(
        MoveDto move)
    {
        try
        {
            MoveResultDto result =
                await ChessGameApiClient.MoveAsync(
                    move);

            ClearSelection();

            await OnMoveCompleted
                .InvokeAsync(result);

            await InvokeAsync(
                StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                ex);

            ClearSelection();

            await InvokeAsync(
                StateHasChanged);
        }
    }


    // ============================================================
    // Превращение пешки
    // ============================================================

    private async Task PromoteAsync(
        string promotion)
    {
        if (_pendingPromotionMove is not MoveDto move)
            return;

        MoveDto promotionMove =
            new(
                move.From,
                move.To,
                promotion);

        _pendingPromotionMove =
            null;

        await ExecuteMoveAsync(
            promotionMove);
    }


    // ============================================================
    // Проверка превращения
    // ============================================================

    private static bool RequiresPromotion(
        PieceDto piece,
        PositionDto destination)
    {
        if (piece.Type != "Pawn")
            return false;

        return piece.Color == "White"
            ? destination.Row == 7
            : destination.Row == 0;
    }


    // ============================================================
    // Очистка выбора
    // ============================================================

    private void ClearSelection()
    {
        _selectedPosition =
            null;

        _legalMoves =
            Array.Empty<PositionDto>();

        _pendingPromotionMove =
            null;
    }


    // ============================================================
    // CSS клетки
    // ============================================================

    private static string GetSquareClass(
        bool isLightSquare,
        bool isSelected,
        bool isLegalMove,
        bool isCapture)
    {
        List<string> classes =
            new()
                {
            "chess-square",

            isLightSquare
                ? "light-square"
                : "dark-square"
                };

        if (isSelected)
        {
            classes.Add(
                "selected-square");
        }

        if (isLegalMove)
        {
            classes.Add(
                "legal-move-square");
        }

        if (isCapture)
        {
            classes.Add(
                "capture-square");
        }

        return string.Join(
            " ",
            classes);
    }


    // ============================================================
    // Символ фигуры
    // ============================================================

    private static string GetPieceSymbol(
        PieceDto piece)
    {
        return (piece.Color, piece.Type) switch
        {
            ("White", "King") =>
                "♔",

            ("White", "Queen") =>
                "♕",

            ("White", "Rook") =>
                "♖",

            ("White", "Bishop") =>
                "♗",

            ("White", "Knight") =>
                "♘",

            ("White", "Pawn") =>
                "♙",

            ("Black", "King") =>
                "♚",

            ("Black", "Queen") =>
                "♛",

            ("Black", "Rook") =>
                "♜",

            ("Black", "Bishop") =>
                "♝",

            ("Black", "Knight") =>
                "♞",

            ("Black", "Pawn") =>
                "♟",

            _ =>
                string.Empty
        };
    }


    // ============================================================
    // Символ превращения
    // ============================================================

    private string GetPromotionSymbol(
        string promotion)
    {
        string color =
            GetPromotionColor();

        return (color, promotion) switch
        {
            ("White", "Q") =>
                "♕",

            ("White", "R") =>
                "♖",

            ("White", "B") =>
                "♗",

            ("White", "N") =>
                "♘",

            ("Black", "Q") =>
                "♛",

            ("Black", "R") =>
                "♜",

            ("Black", "B") =>
                "♝",

            ("Black", "N") =>
                "♞",

            _ =>
                string.Empty
        };
    }


    // ============================================================
    // Цвет превращаемой пешки
    // ============================================================

    private string GetPromotionColor()
    {
        if (_pendingPromotionMove is not MoveDto move)
            return "White";

        PieceDto? pawn =
            GetPiece(move.From);

        return pawn?.Color ?? "White";
    }


    // ============================================================
    // Отладочное представление клетки
    // ============================================================

    private static string ToSquare(
        PositionDto position)
    {
        char file =
            (char)('a' + position.Column);

        int rank =
            position.Row + 1;

        return $"{file}{rank}";
    }

}
