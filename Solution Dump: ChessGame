using ChessGame.Contracts.Dto;
using System.Net.Http.Json;

namespace ChessGame.ApiClient.Services
{

    public sealed class ChessGameApiClient : IChessGameApiClient
    {
        private readonly HttpClient _httpClient;

        public Guid? GameId { get; private set; }
        public GameDto? Game { get; private set; }

        public ChessGameApiClient(HttpClient httpClient)
        {
            _httpClient = httpClient;
        }

        public async Task<GameDto> NewGameAsync()
        {
            HttpResponseMessage response = await _httpClient.PostAsync("api/games", null);
            response.EnsureSuccessStatusCode();

            GameDto game = await response.Content.ReadFromJsonAsync<GameDto>()
                ?? throw new InvalidOperationException("Server returned empty game.");

            GameId = game.Id;
            Game = game;

            return game;
        }

        public async Task<GameDto> LoadGameAsync(Guid gameId)
        {
            GameDto game = await _httpClient.GetFromJsonAsync<GameDto>($"api/games/{gameId}")
                ?? throw new InvalidOperationException("Server returned empty game.");

            GameId = game.Id;
            Game = game;

            return game;
        }

        public async Task<MoveResultDto> MoveAsync(MoveDto move)
        {
            EnsureGame();

            MoveResultDto result = await PostAsync<MoveDto, MoveResultDto>($"api/games/{GameId}/move", move);

            // Обновляем состояние игры после хода
            await LoadGameAsync(GameId!.Value);

            return result;
        }

        public async Task<GameDto> UndoAsync()
        {
            EnsureGame();

            GameDto game = await PostAsync<object, GameDto>($"api/games/{GameId}/undo", new { });
            Game = game;

            return game;
        }

        public async Task<IReadOnlyCollection<PositionDto>> GetLegalMovesAsync(PositionDto position)
        {
            EnsureGame();
            Console.WriteLine($"GetLegalMovesAsync: GameId={GameId}, square={ToSquare(position)}");

            PositionDto[] moves = await GetFromJsonAsync<PositionDto[]>($"api/games/{GameId}/legalmoves/{ToSquare(position)}");
            return moves;
        }

        public async Task DeleteGameAsync()
        {
            EnsureGame();

            HttpResponseMessage response = await _httpClient.DeleteAsync($"api/games/{GameId}");
            response.EnsureSuccessStatusCode();

            GameId = null;
            Game = null;
        }

        private async Task<TResponse> PostAsync<TRequest, TResponse>(string url, TRequest request)
        {
            HttpResponseMessage response = await _httpClient.PostAsJsonAsync(url, request);
            response.EnsureSuccessStatusCode();

            return await response.Content.ReadFromJsonAsync<TResponse>()
                ?? throw new InvalidOperationException("Server returned empty response.");
        }

        private async Task<TResponse> GetFromJsonAsync<TResponse>(string url)
        {
            return await _httpClient.GetFromJsonAsync<TResponse>(url)
                ?? throw new InvalidOperationException("Server returned empty response.");
        }

        private static string ToSquare(PositionDto position)
        {
            char file = (char)('a' + position.Column);
            int rank = position.Row + 1;
            return $"{file}{rank}";
        }

        private void EnsureGame()
        {
            if (GameId == null)
            {
                throw new InvalidOperationException("Game has not been created.");
            }
        }
    }
}
