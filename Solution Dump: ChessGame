```razor
@page "/game"
@rendermode InteractiveServer

@using ChessGame.Contracts.Dto
@using ChessGame.Web.Components
@using ChessGame.ApiClient.Services

@inject IChessGameApiClient ChessGameApiClient

<div class="game-page">

    <h1>Chess</h1>

    <div class="game-layout">

        <div class="board-container">

            <ChessBoard Game="ChessGameApiClient.Game"
                        OnMoveCompleted="MoveCompleted" />

        </div>

        <div class="game-panel">

            <h2>Match</h2>

            @if (ChessGameApiClient.Game != null)
            {
                <div class="game-info">

                    <div class="info-row">

                        <span class="info-label">
                            Move
                        </span>

                        <span class="info-value">
                            @ChessGameApiClient.Game.CurrentTurn
                        </span>

                    </div>

                    <div class="info-row">

                        <span class="info-label">
                            State
                        </span>

                        <span class="info-value">
                            @ChessGameApiClient.Game.State
                        </span>

                    </div>

                </div>

                @if (_lastEvents.Count > 0)
                {
                    <div class="game-events">

                        @foreach (GameEventDto gameEvent in _lastEvents)
                        {
                            <div class="@GetEventCssClass(gameEvent.Type)">

                                <div class="event-title">
                                    @GetEventTitle(gameEvent.Type)
                                </div>

                                <div class="event-message">
                                    @gameEvent.Message
                                </div>

                            </div>
                        }

                    </div>
                }

                <div class="move-history">

                    <h3>Move history (SAN)</h3>

                    @if (ChessGameApiClient.Game.Moves.Count == 0)
                    {
                        <div class="empty-history">
                            No moves yet
                        </div>
                    }
                    else
                    {
                        @for (
                       int index = 0;
                       index < ChessGameApiClient.Game.Moves.Count;
                       index += 2)
                        {
                            MoveRecordDto whiteMove =
                            ChessGameApiClient.Game.Moves.ElementAt(index);

                            <div class="move-row">

                                <span class="move-number">
                                    @(index / 2 + 1).
                                </span>

                                <span class="move-white">
                                    @whiteMove.San
                                </span>

                                @if (index + 1 < ChessGameApiClient.Game.Moves.Count)
                                {
                                    MoveRecordDto blackMove =
                                    ChessGameApiClient.Game.Moves.ElementAt(index + 1);

                                    <span class="move-black">
                                        @blackMove.San
                                    </span>
                                }

                            </div>
                        }
                    }

                </div>
            }
            else
            {
                <div class="empty-history">
                    No game started
                </div>
            }

            <button class="new-game-button"
                    @onclick="NewGame">

                New Game

            </button>

            <button class="undo-button"
                    @onclick="Undo"
                    disabled="@(ChessGameApiClient.Game?.Moves.Count == 0)">

                ↶ Undo move

            </button>

        </div>

    </div>

</div>

@code
{
    private IReadOnlyCollection<GameEventDto> _lastEvents =
    Array.Empty<GameEventDto>();

    // ============================================================
    // INITIALIZATION
    // ============================================================

    protected override async Task OnInitializedAsync()
    {
        if (ChessGameApiClient.Game == null)
        {
            await ChessGameApiClient.NewGameAsync();
        }
    }


    // ============================================================
    // NEW GAME
    // ============================================================

    private async Task NewGame()
    {
        await ChessGameApiClient.NewGameAsync();

        _lastEvents =
            Array.Empty<GameEventDto>();

        await InvokeAsync(
            StateHasChanged);
    }


    // ============================================================
    // UNDO
    // ============================================================

    private async Task Undo()
    {
        Console.WriteLine("=== UNDO BUTTON CLICKED ===");

        if (ChessGameApiClient.Game == null)
        {
            Console.WriteLine("UNDO: Game == null");
            return;
        }

        Console.WriteLine(
            $"UNDO: GameId = {ChessGameApiClient.GameId}");

        Console.WriteLine(
            $"UNDO: Moves before = {ChessGameApiClient.Game.Moves.Count}");

        try
        {
            GameDto game =
                await ChessGameApiClient.UndoAsync();

            Console.WriteLine(
                $"UNDO: Moves after = {game.Moves.Count}");

            Console.WriteLine(
                $"UNDO: CurrentTurn = {game.CurrentTurn}");

            _lastEvents =
                Array.Empty<GameEventDto>();

            await InvokeAsync(
                StateHasChanged);

            Console.WriteLine("=== UNDO COMPLETED ===");
        }
        catch (Exception ex)
        {
            Console.WriteLine("=== UNDO ERROR ===");
            Console.WriteLine(ex);

            _lastEvents =
                new[]
                {
                new GameEventDto(
                    "Error",
                    $"Undo error: {ex.Message}")
                        };

            await InvokeAsync(
                StateHasChanged);
        }
    }


    // ============================================================
    // MOVE COMPLETED
    // ============================================================

    private async Task MoveCompleted(
        MoveResultDto result)
    {
        _lastEvents =
            result.Events.ToArray();

        await InvokeAsync(
            StateHasChanged);
    }


    // ============================================================
    // EVENT TITLE
    // ============================================================

    private static string GetEventTitle(
        string eventType)
