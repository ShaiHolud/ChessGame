using ChessGame.Contracts.Dto;
using ChessGame.Core;
using ChessGame.Core.Events;
using ChessGame.Core.Model;
using ChessGame.Core.Pieces;
using ChessGame.Core.Results;

namespace ChessGame.Application.Games
{
    public sealed class ChessGameService : IChessGameService
    {
        private readonly GameManager _gameManager;

        public ChessGameService(GameManager gameManager)
        {
            _gameManager = gameManager;
        }

        public GameDto CreateGame()
        {
            GameSession session =
                _gameManager.CreateGame();

            return MapGame(
                session.Id,
                session.Game);
        }

        public GameDto GetGame(Guid gameId)
        {
            GameSession session =
                GetRequiredGame(gameId);

            return MapGame(
                session.Id,
                session.Game);
        }

        public MoveResultDto MakeMove(Guid gameId, MoveDto moveDto)
        {
            GameSession session =
                GetRequiredGame(gameId);

            Move move =
                MapMove(moveDto);

            MoveResult result =
                session.Game.Move(move);

            session.LastActivity =
                DateTime.UtcNow;

            return MapMoveResult(result);
        }

        public GameDto UndoMove(Guid gameId)
        {
            GameSession session =
                GetRequiredGame(gameId);

            session.Game.Undo();

            session.LastActivity =
                DateTime.UtcNow;

            return MapGame(
                session.Id,
                session.Game);
        }

        public IReadOnlyCollection<PositionDto> GetLegalMoves(Guid gameId, PositionDto positionDto)
        {
            GameSession session =
                GetRequiredGame(gameId);

            Position position = new(
                positionDto.Row,
                positionDto.Column);

            return session.Game
                .GetLegalMoves(position)
                .Select(move =>
                    new PositionDto(
                        move.To.Row,
                        move.To.Column))
                .ToArray();
        }

        public bool DeleteGame(Guid gameId)
        {
            return _gameManager.Remove(gameId);
        }

        public IReadOnlyCollection<GameInfoDto> GetGames()
        {
            return _gameManager
                .GetAll()
                .Select(session => new GameInfoDto
                {
                    Id = session.Id,

                    CurrentTurn =
                        session.Game.CurrentTurn.ToString(),

                    LastActivity =
                        session.LastActivity,

                    WhitePieces =
                        session.Game
                            .GetPieces(PieceColor.White)
                            .Count(),

                    BlackPieces =
                        session.Game
                            .GetPieces(PieceColor.Black)
                            .Count(),

                    Finished =
                        session.Game.IsFinished,

                    State =
                        session.Game.State.ToString()
                })
                .ToArray();
        }

        private GameSession GetRequiredGame(Guid gameId)
        {
            GameSession? session =
                _gameManager.Get(gameId);

            if (session == null)
            {
                throw new KeyNotFoundException(
                    $"Game '{gameId}' was not found.");
            }

            return session;
        }

        // ============================================================
        // Mapping: Application DTO -> Core
        // ============================================================

        private static Move MapMove(MoveDto dto)
        {
            Position from = new(
                dto.From.Row,
                dto.From.Column);

            Position to = new(
                dto.To.Row,
                dto.To.Column);

            PromotionPiece? promotion =
                ParsePromotion(dto.Promotion);

            return new Move(
                from,
                to,
                promotion);
        }

        private static PromotionPiece? ParsePromotion(string? promotion)
        {
            if (string.IsNullOrWhiteSpace(promotion))
            {
                return null;
            }

            return promotion.ToUpperInvariant() switch
            {
                "Q" or "QUEEN" =>
                    PromotionPiece.Queen,

                "R" or "ROOK" =>
                    PromotionPiece.Rook,

                "B" or "BISHOP" =>
                    PromotionPiece.Bishop,

                "N" or "KNIGHT" =>
                    PromotionPiece.Knight,

                _ => throw new ArgumentException(
                    $"Unknown promotion piece '{promotion}'.")
            };
        }

        // ============================================================
        // Mapping: Core -> Application DTO
        // ============================================================

        private static GameDto MapGame(Guid gameId, Game game)
        {
            IReadOnlyCollection<PieceDto> pieces =
                game.GetAllPieces()
                    .Select(MapPiece)
                    .ToArray();

            IReadOnlyCollection<MoveRecordDto> moves =
                game.MoveRecords
                    .Select(MapMoveRecord)
                    .ToArray();

            return new GameDto(
                gameId,
                game.CurrentTurn.ToString(),
                game.State.ToString(),
                game.IsFinished,
                game.State == GameState.Check,
                game.State == GameState.Checkmate,
                game.State == GameState.Stalemate,
                game.State == GameState.Draw,
                pieces,
                moves);
        }

        private static PieceDto MapPiece(ChessPiece piece)
        {
            return new PieceDto(
                piece.GetType().Name,
                piece.Color.ToString(),
                new PositionDto(
                    piece.Position.Row,
                    piece.Position.Column));
        }

        private static MoveRecordDto MapMoveRecord(MoveRecord record)
        {
            return new MoveRecordDto(
                MapMove(record.Move),
                record.Notation);
        }

        private static MoveDto MapMove(Move move)
        {
            return new MoveDto(
                new PositionDto(
                    move.From.Row,
                    move.From.Column),

                new PositionDto(
                    move.To.Row,
                    move.To.Column),

                move.Promotion?.ToString());
        }

        private static MoveResultDto MapMoveResult(MoveResult result)
        {
            IReadOnlyCollection<GameEventDto> events =
                result.Events
                    .Select(MapEvent)
                    .ToArray();

            MoveDto? move = null;

            if (result.Move is Move coreMove)
            {
                move = MapMove(coreMove);
            }

            return new MoveResultDto(
                result.Success,
                move,
                result.San,
                result.State.ToString(),
                result.CurrentTurn.ToString(),
                result.Check,
                result.Checkmate,
                result.Stalemate,
                result.Draw,
                events);
        }

        private static GameEventDto MapEvent(GameEvent gameEvent)
        {
            return new GameEventDto(
                gameEvent.Type.ToString(),
                gameEvent.Message);
        }
    }
}
